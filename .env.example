# Copy this file to .env and fill in real values. .env is gitignored so secrets never get committed.

# --- Postgres connection for the MusicBrainz database ---
# Used by scripts/setup_musicbrainz_db.sh (as the admin/import user) and by
# semantic/generator/introspect.py (schema reflection).
PGHOST=localhost
PGPORT=5432
PGDATABASE=musicbrainz
PGUSER=musicbrainz
PGPASSWORD=musicbrainz

# --- Read-only role used by the agent's query-execution tool ---
# Created by scripts/create_readonly_role.sql. The agent NEVER connects as
# PGUSER above — only as this role, which has SELECT-only grants.
MB_RO_USER=mb_analytics_ro
MB_RO_PASSWORD=change-me

# --- Anthropic / claude-agent-sdk ---
ANTHROPIC_API_KEY=sk-ant-...
